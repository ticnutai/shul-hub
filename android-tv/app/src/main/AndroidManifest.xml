<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android TV requirements. Without the leanback feature and the
        LEANBACK_LAUNCHER category below, this package installs but never
        appears on the TV home screen, which is the only launcher the device
        has.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- A television has no touchscreen; declaring it required would make the
         app ineligible for every TV device. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER is kept so the package can also be started from a
                     sideloading tool or a file manager during setup. -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Restores the board after a power cut. `directBootAware` lets it run
             before the device is unlocked, which is when a TV box boots. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read so the display can tell "the server is down" from "this TV lost
         Wi-Fi", and reconnect promptly when the link returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The board must stay readable indefinitely; without this the system
         dims and then blanks the screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets BootReceiver bring the board back after a power cut. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Receiving BOOT_COMPLETED is not enough on its own. Since Android 10 an
         app in the background may not open an activity, and the system drops
         the attempt SILENTLY (seen on the device: "Background activity launch
         blocked ... BAL_BLOCK", no exception reaches the app). Holding "display
         over other apps" is one of the documented exemptions. A TV has no
         convenient screen to grant it, so it is granted once over ADB:
           node scripts/tv-control.mjs autostart -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
